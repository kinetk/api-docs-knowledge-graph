# MCP server config. The MCP is a thin adapter — it only needs the
# graph-service base URL and an API key. All retrieval state lives server-side.

# Base URL of the deployed graph-service API:
#   dev:  https://api.dev.kinetk.ai/graph
#   prod: https://api.kinetk.ai/graph
GRAPH_SERVICE_URL=

# API key issued by API Gateway. Sent on every request as `x-api-key`.
GRAPH_SERVICE_API_KEY=

# Optional: per-request HTTP timeout in milliseconds. The graph-service submit
# path returns in <500 ms; status reads are similar. 10 s is a generous default.
GRAPH_SERVICE_TIMEOUT_MS=10000
